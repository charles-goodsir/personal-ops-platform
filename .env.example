# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ops
# Host port. Change it if 5432 is taken by another project.
POSTGRES_PORT=5432
DATABASE_URL=postgres://ops:change-me@localhost:5432/ops

# MCP server HTTP transport
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Docker: host address the server is published on. Mini PC: its LAN IP.
MCP_PUBLISH_ADDR=127.0.0.1
# Hostnames clients may use in the Host header (DNS rebinding protection).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Mini PC example: MCP_ALLOWED_HOSTS=192.168.88.18,cyber-homelab.local
# Comma-separated, each at least 32 chars. Generate: openssl rand -hex 32
# To rotate: add the new token, update clients, then remove the old one.
MCP_AUTH_TOKENS=

# Embeddings (Ollama). Compose points services at http://ollama:11434.
# Changing the model means re-embedding every note.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Folder of Markdown, text and PDF notes to index. Compose mounts it
# read-only at /notes. Mini PC example: NOTES_DIR=/home/owner/notes
NOTES_DIR=./notes

# Nightly backups. Host folder for pg_dump files (owner-only), and the uid/gid
# they are written as: run `id -u` and `id -g` on the host.
BACKUP_DIR=./backups
BACKUP_UID=1000
BACKUP_GID=1000

# Akahu personal app (my.akahu.nz > Developers). Keep .env chmod 600.
AKAHU_APP_TOKEN=app_token_...
AKAHU_USER_TOKEN=user_token_...

# Claude API: categorises transactions the rules don't cover. Model ids are
# config, not code. Only masked descriptions and amounts are sent.
ANTHROPIC_API_KEY=
CLAUDE_BULK_MODEL=claude-haiku-5-5

# Earliest transaction date to fetch and keep (YYYY-MM-DD). Moving it later
# deletes older local copies on the next sync; moving it back re-fetches them.
FINANCE_HISTORY_START=2026-01-01

# Weekly summary on Telegram. Create a bot with @BotFather, message it once,
# then read your chat id from /getUpdates. Only aggregates reach the model.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CLAUDE_SUMMARY_MODEL=claude-sonnet-5-5
# Optional. The ping URL of a Healthchecks.io check: the bot service pings it every
# watchdog run, so you hear about it when the bot or Telegram is down. The id in
# the URL is the secret. Leave empty to turn it off.
HEALTHCHECK_PING_URL=

# Daily briefing: sent at BRIEFING_TIME (NZ, 24-hour). The coordinates are the
# only thing sent to Open-Meteo for the weather. Suburb level is enough.
BRIEFING_TIME=08:30
WEATHER_LAT=-36.97
WEATHER_LON=174.82

# Yesterday's diary entries, as a separate message at DIARY_TIME (NZ, 24-hour).
DIARY_TIME=09:00

# Daily finance sync from Akahu, 24-hour NZ time. Runs before the briefing.
FINANCE_SYNC_TIME=08:00

# The Telegram bot also answers commands (/spend, /subs, /notes, /briefing)
# from the chat above, and ignores every other chat. It uses the same
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID and WEATHER_* values.

# Dashboard: a read-only page on 127.0.0.1, reached with an SSH tunnel. The
# password is asked for by the browser. Make one with: openssl rand -hex 24
DASHBOARD_PASSWORD=
# Set to true to hide payee names on the dashboard, for screenshots.
DASHBOARD_HIDE_PAYEES=false
